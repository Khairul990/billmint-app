# BillQyro Phase 2 — Local Development Environment Configuration
# DO NOT PUT PRODUCTION SECRETS OR FIREBASE PRIVATE KEYS IN THIS FILE

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# PostgreSQL Database Configuration (Local Docker)
DATABASE_URL=postgres://billqyro_dev_user:dev_secure_password_123@localhost:5432/billqyro_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=billqyro_dev
POSTGRES_USER=billqyro_dev_user
POSTGRES_PASSWORD=dev_secure_password_123
POSTGRES_SSL=false

# Cloudflare R2 / MinIO Object Storage Emulator (Local Docker)
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minio_admin
R2_SECRET_ACCESS_KEY=minio_dev_secret_123
R2_BUCKET_NAME=billqyro-storage-dev
R2_PUBLIC_URL=http://localhost:9000/billqyro-storage-dev

# Security & Session (Local Dev Secrets Only)
JWT_SECRET=billqyro_dev_jwt_super_secret_key_minimum_32_chars
SESSION_EXPIRY_HOURS=24
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
