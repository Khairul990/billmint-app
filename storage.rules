rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Payment Proofs Uploaded by Customers via Live Links
    match /payment_proofs/{fileName} {
      // Anyone can read payment proofs
      allow read: if true;
      // Limit uploads to images and max size of 5MB
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Business Logos Uploaded by Users
    match /business_logos/{fileName} {
      allow read: if true;
      // Only authenticated users can upload logos
      allow write: if request.auth != null 
                   && request.resource.size < 2 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
    }

    // Other generic assets protection
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'khairul2052007@gmail.com';
    }
  }
}
