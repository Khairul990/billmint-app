rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Payment Proofs Uploaded by Customers via Live Links
    match /paymentProofs/{invoiceId}/{fileName} {
      // Anyone can upload a proof, but only if they are uploading to a valid invoice ID
      // and the image must be under 10MB
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && firestore.exists(/databases/(default)/documents/publicInvoices/$(invoiceId));
      // Only authenticated users (admins/business owners) can read the proofs
      allow read: if request.auth != null;
    }

    // Business Logos Uploaded by Users
    match /business_logos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.resource.size < 2 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
    }

    // Per-user document uploads (e.g. invoices, reports)
    match /user_uploads/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/.*');
    }

    // Admin-only bucket for platform assets
    match /admin_assets/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'khairul2052007@gmail.com';
    }

    // Generic catch-all — explicitly deny by default to prevent unauthorized access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
