rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(userId) { return isAuth() && request.auth.uid == userId; }
    function isAdmin() { return isAuth() && request.auth.token.superAdmin == true; }

    function isValidPublicInvoiceData() {
      let diff = request.resource.data.diff(resource.data);
      let allowedKeysOnly = diff.affectedKeys().hasOnly(['paymentProofs', 'paymentStatus', 'updatedAt']);
      let allowedStatusUpdate = !diff.affectedKeys().hasAny(['paymentStatus']) || request.resource.data.paymentStatus == 'Pending Verification';
      return allowedKeysOnly && allowedStatusUpdate;
    }

    match /invoices/{userId}/items/{itemId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && (!("userId" in resource.data) || resource.data.userId == request.auth.uid) && request.resource.data.userId == request.auth.uid;
    }

    match /customers/{userId}/items/{itemId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && (!("userId" in resource.data) || resource.data.userId == request.auth.uid) && request.resource.data.userId == request.auth.uid;
    }

    match /products/{userId}/items/{itemId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && (!("userId" in resource.data) || resource.data.userId == request.auth.uid) && request.resource.data.userId == request.auth.uid;
    }

    match /students/{userId}/items/{itemId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && (!("userId" in resource.data) || resource.data.userId == request.auth.uid) && request.resource.data.userId == request.auth.uid;
    }

    match /expenses/{userId}/items/{itemId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /bankLedger/{userId}/items/{itemId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /bankCredit/{userId}/items/{itemId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /bankMeta/{userId}/items/{docId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /auditLogs/{userId}/items/{itemId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /errorLogs/{userId}/items/{itemId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /settings/{userId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'role', 'subscription']);
    }

    match /invoice_counters/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /subscription/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /usersList/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
      allow create: if isOwner(userId) && !request.resource.data.keys().hasAny(['role', 'isAdmin', 'plan', 'permissions', 'subscription', 'businessId']);
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'plan', 'permissions', 'subscription', 'businessId']);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/sessions/{sessionId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() <= 100
        && request.resource.data.sessionSecretHash is string
        && request.resource.data.sessionSecretHash.size() == 64;
      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.sessionSecretHash == resource.data.sessionSecretHash
        && request.resource.data.status == resource.data.status;
      allow delete: if false;
    }

    match /publicInvoices/{publicToken} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if (isAuth() && (!("userId" in resource.data) || resource.data.userId == request.auth.uid)) || isValidPublicInvoiceData();
    }

    match /public_invoices/{publicToken} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if (isAuth() && (!("userId" in resource.data) || resource.data.userId == request.auth.uid)) || isValidPublicInvoiceData();
    }

    match /premiumRequests/{requestId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /payment_proofs/{proofId} {
      allow create: if (isAuth() && request.resource.data.ownerId == request.auth.uid) || (!isAuth() && request.resource.data.status == 'pending' && request.resource.data.publicInvoiceId != null);
      allow read: if isAuth() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /platformConfig/{configId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /globalAdminSettings/{configId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /featureRequests/{requestId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /adminAnnouncements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminRevenueSettings/{configId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /platformRevenue/{revenueId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /platformPaymentProofs/{proofId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /adminSettings/{configId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /appChangelogs/{logId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /control_website_events/{eventId} {
      allow read, write: if isAdmin();
    }

    match /control_website_errors/{eventId} {
      allow read, write: if isAdmin();
    }

    match /control_website_health/{healthId} {
      allow read, write: if isAdmin();
    }
  }
}
