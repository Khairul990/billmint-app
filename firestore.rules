rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Rules for users collection and their private subcollections (like invoices)
    match /users/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
      
      match /invoices/{invoiceId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }
    }
    
    // Rules for publicInvoices
    match /publicInvoices/{publicToken} {
      // Anyone can read a public invoice
      allow read: if true;
      
      // Only authenticated owners can create or delete public invoices fully
      allow create, delete: if isAuth();
      
      // Unauthenticated users (customers) can only update payment proofs and paymentStatus
      allow update: if isAuth() || (
        // The diff shows that only paymentProofs and paymentStatus fields are modified
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProofs', 'paymentStatus'])
      );
    }

    // Rules for legacy public_invoices
    match /public_invoices/{publicToken} {
      allow read: if true;
      allow create, delete: if isAuth();
      allow update: if isAuth() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProofs', 'paymentStatus'])
      );
    }
    
    // Rules for other collections to maintain backward compatibility
    match /settings/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    match /subscription/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    match /customers/{userId}/items/{customerId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    match /invoices/{userId}/items/{invoiceId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    match /products/{userId}/items/{productId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    match /expenses/{userId}/items/{expenseId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    match /premiumRequests/{requestId} {
      allow read, write: if isAuth(); // Could be restricted further but kept simple for now
    }
    match /usersList/{userId} {
      // Any authenticated user might need to write here on signup, 
      // but only admin or self should read. For now restrict to self or admin.
      allow write: if isAuth();
      allow read: if isAuth() && (request.auth.uid == userId || request.auth.token.email == 'khairul2052007@gmail.com');
    }
    match /platformConfig/{configId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.token.email == 'khairul2052007@gmail.com';
    }
  }
}
