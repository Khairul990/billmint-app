rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper to check if user is owner
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Helper to check if user is Super Admin
    function isAdmin() {
      return isAuth() && request.auth.token.email == 'khairul2052007@gmail.com';
    }

    // -------------------------------------------------------------------------
    // Private Workspace Data (Subcollections under user ID)
    // -------------------------------------------------------------------------

    match /invoices/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /customers/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /products/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /expenses/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /auditLogs/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /errorLogs/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Settings and Profiles
    // -------------------------------------------------------------------------

    match /settings/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /invoice_counters/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /subscription/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // UsersList - Role escalation protection
    match /usersList/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Super admin can do anything
      allow write: if isAdmin();
      
      // Normal users cannot set dangerous role/subscription fields
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['role', 'isAdmin', 'plan', 'permissions', 'subscription', 'businessId']);
        
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'plan', 'permissions', 'subscription', 'businessId']);
        
      allow delete: if isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // Public Assets (Live Invoice Links)
    // -------------------------------------------------------------------------

    match /publicInvoices/{publicToken} {
      // Anyone can read a public invoice
      allow read: if true;
      
      // Only authenticated owners can create or delete public invoices fully
      allow create, delete: if isAuth();
      
      // Unauthenticated users (customers) can only update payment proofs
      allow update: if isAuth() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProofs', 'paymentStatus'])
      );
    }

    // Legacy fallback
    match /public_invoices/{publicToken} {
      allow read: if true;
      allow create, delete: if isAuth();
      allow update: if isAuth() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProofs', 'paymentStatus'])
      );
    }

    // -------------------------------------------------------------------------
    // Admin & Billing
    // -------------------------------------------------------------------------

    match /premiumRequests/{requestId} {
      // Users can only read/write their own requests
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    match /payment_proofs/{proofId} {
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isAuth() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    match /platformConfig/{configId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /globalAdminSettings/{configId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
